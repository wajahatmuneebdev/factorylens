# Required durable worker state.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/factorylens

# Private worker access to the same R2 bucket used by the API.
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
R2_BUCKET=factorylens-private
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Optional local development overrides. The defaults are shown here.
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
# Local mode is accepted only on a loopback host. Match the API token.
WORKER_AUTH_MODE=local
LOCAL_WORKER_TASK_TOKEN=REPLACE_WITH_A_HIGH_ENTROPY_LOCAL_TASK_TOKEN

# Cloud Tasks calls the private task route with a Google-signed OIDC token.
WORKER_OIDC_AUDIENCE=https://factorylens-worker.example
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=factorylens-tasks@YOUR_PROJECT.iam.gserviceaccount.com

# Media policy is rechecked from inspected bytes and ffprobe metadata.
MAX_UPLOAD_BYTES=262144000
MAX_MEDIA_DURATION_MS=300000
MAX_MEDIA_WIDTH=1920
MAX_MEDIA_HEIGHT=1080

# The deterministic fixture is the credential-free local inference endpoint.
WORKFLOW_ENDPOINT=fixture://assembly-line-no-hard-hat

# To call the selected Workflow on Roboflow Cloud or a compatible self-hosted
# Inference server, replace the fixture endpoint and configure these values.
# Keep ROBOFLOW_API_KEY in the worker's secret store; use
# WORKFLOW_CREDENTIAL_SOURCE=none only for an endpoint that requires no key.
# WORKFLOW_ENDPOINT=https://serverless.roboflow.com
# WORKFLOW_WORKSPACE=YOUR_ROBOFLOW_WORKSPACE
# WORKFLOW_FINGERPRINT=sha256:EXPORTED_VERSIONED_WORKFLOW_SHA256
# WORKFLOW_CREDENTIAL_SOURCE=roboflow-api-key
# ROBOFLOW_API_KEY=YOUR_SECRET_API_KEY
# WORKFLOW_REQUEST_TIMEOUT_SECONDS=30
# WORKFLOW_USE_CACHE=true
