{
  "name": "@factorylens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/*.integration.test.ts\"",
    "test:integration": "vitest run test/database.integration.test.ts"
  },
  "dependencies": {
    "@factorylens/contracts": "^0.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
