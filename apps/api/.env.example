# Optional local development overrides. The defaults are shown here.
API_HOST=127.0.0.1
API_PORT=3000

# Required to run the API with Google sign-in and private R2 storage.
APP_ORIGIN=https://factorylens.example
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/factorylens
GOOGLE_OIDC_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OIDC_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Generate a high-entropy value of at least 32 characters.
AUTH_COOKIE_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_SECRET
# Per-user work and media policy. The public request contract caps uploads at
# 250 MiB, so MAX_UPLOAD_BYTES may only make that envelope stricter.
MAX_ACTIVE_INSPECTIONS_PER_USER=3
MAX_UPLOAD_BYTES=262144000
MAX_PROCESSING_ATTEMPTS=3
# Cloud Scheduler sends an OIDC token with this audience and service identity.
MAINTENANCE_OIDC_AUDIENCE=https://factorylens.example/internal/maintenance/reconcile
MAINTENANCE_SERVICE_ACCOUNT_EMAIL=factorylens-maintenance@YOUR_PROJECT.iam.gserviceaccount.com
MAINTENANCE_DISPATCH_GRACE_SECONDS=300
MAINTENANCE_ABANDONED_UPLOAD_HOURS=24
MAINTENANCE_RETENTION_DAYS=30
MAINTENANCE_BATCH_SIZE=50
MAINTENANCE_MAX_DURATION_SECONDS=50
# Use an R2 API token scoped to this private bucket only.
R2_ACCOUNT_ID=YOUR_32_CHARACTER_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=factorylens-private
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Use local for development. NODE_ENV=production requires cloud-tasks with
# Application Default Credentials and the configuration below.
TASK_DISPATCHER=local
CLOUD_TASKS_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=factorylens-processing
CLOUD_TASKS_TARGET_URL=https://factorylens-worker.example/internal/tasks/process
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=factorylens-tasks@YOUR_PROJECT.iam.gserviceaccount.com
# Override only when the worker validates a custom OIDC audience.
# CLOUD_TASKS_OIDC_AUDIENCE=https://factorylens-worker.example
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=1800
CLOUD_TASKS_MAX_DISPATCHES_PER_SECOND=1
CLOUD_TASKS_MAX_CONCURRENT_DISPATCHES=1
CLOUD_TASKS_MAX_ATTEMPTS=3
CLOUD_TASKS_MAX_RETRY_DURATION_SECONDS=0
CLOUD_TASKS_MIN_BACKOFF_SECONDS=10
CLOUD_TASKS_MAX_BACKOFF_SECONDS=300
CLOUD_TASKS_MAX_DOUBLINGS=3

# Required only for the migration integration test.
# Use an empty disposable database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/factorylens_test
