# Optional local development overrides. The defaults are shown here.
API_HOST=127.0.0.1
API_PORT=3000

# Required to run the API with Google sign-in.
APP_ORIGIN=https://factorylens.example
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/factorylens
GOOGLE_OIDC_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OIDC_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Generate a high-entropy value of at least 32 characters.
AUTH_COOKIE_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_SECRET

# Required only for the migration integration test.
# Use an empty disposable database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/factorylens_test
