project_id         = "factorylens-production"
region             = "us-east4"
billing_account_id = "000000-000000-000000"

github_repository        = "wajahatmuneebdev/factorylens"
github_deployment_branch = "main"

# Use an immutable tag or digest produced by the image build.
web_image    = "us-east4-docker.pkg.dev/factorylens-production/factorylens/web@sha256:REPLACE"
worker_image = "us-east4-docker.pkg.dev/factorylens-production/factorylens/worker@sha256:REPLACE"

application_origin    = "https://factorylens-web-874221858225.us-east4.run.app"
google_oidc_client_id = "REPLACE.apps.googleusercontent.com"

r2_account_id = "00000000000000000000000000000000"
r2_bucket     = "factorylens-private"

workflow_endpoint    = "https://serverless.roboflow.com"
workflow_workspace   = "factorylens-uzfw1"
workflow_version_id  = "1794990512449"
workflow_fingerprint = "sha256:f18ade6ea1b86bf6e3b245a2329b57d67bbcc2491facd78d55f669c9170ba0a1"

# Locally benchmarked candidate envelope. These may be made stricter, but
# increasing them beyond these values requires a new benchmark and architecture
# review. Complete PROCESSING_ENVELOPE.md's deployed gate before real-user use.
max_upload_bytes                = 262144000
max_media_duration_ms           = 300000
max_media_width                 = 1920
max_media_height                = 1080
max_active_inspections_per_user = 3
max_processing_attempts         = 3
terminal_retention_days         = 30
abandoned_upload_hours          = 24

# Set a reviewed initial monthly budget. Default billing recipients and project
# owners receive alerts; add Monitoring channel resource names when available.
monthly_budget_usd          = 100
budget_notification_channels = []
